# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Monthly listing fee in paise (3000 = Rs 30)
LISTING_FEE_PAISE=3000

# Razorpay Subscriptions (AutoPay) — Dashboard -> Subscriptions -> Plans
# The ₹30/month recurring plan. 6-month and 12-month remain one-time payments.
RAZORPAY_MONTHLY_PLAN_ID=plan_xxxxxxxxxxxxx

# Phone-OTP proof signing (koi bhi lambi random string, kam se kam 16 characters, kabhi share mat karo)
OTP_PROOF_SECRET=change-me-to-a-long-random-string

# Dukaan Order System ki opt-in shops dikhane ke liye (Dukaan ke Supabase ki PUBLIC anon key, koi secret nahi)
# Khaali chhodo to Verilo par shops nahi dikhengi (baaki sab normal chalega)
DUKAAN_SUPABASE_URL=
DUKAAN_SUPABASE_ANON_KEY=
# Optional: shop ke storefront ka base link (default https://dukaan-order-system.vercel.app)
DUKAAN_STOREFRONT_URL=
